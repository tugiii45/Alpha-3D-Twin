# Local and container defaults. PORT inside Docker is forced to 8080.
PORT=8080
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=

# Required to accept inbound SMS webhooks; set the same secret with ThriveWave.
SMS_WEBHOOK_TOKEN=

# ThriveWave SMS. Leave blank until the provider host is confirmed.
THRIVEWAVE_API_KEY=
THRIVEWAVE_SENDER_ID=
THRIVEWAVE_BASE_URL=

# OpenAI-compatible chat completions. Point CURSOR_BASE_URL at OpenAI
# or any Cursor gateway that speaks the same /v1/chat/completions contract.
CURSOR_API_KEY=
CURSOR_BASE_URL=https://api.openai.com
CURSOR_MODEL=gpt-4o-mini
